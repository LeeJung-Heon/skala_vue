# OpenWeatherMap API key
# https://home.openweathermap.org/api_keys
#
# 로컬: 이 파일을 복사해 .env 를 만들고 키를 넣으세요.
#   cp .env.example .env
#
# GitHub Pages: .env 는 커밋하지 마세요.
#   Repo → Settings → Secrets and variables → Actions
#   에 Name: VITE_OPENWEATHER_API_KEY 로 Secret 을 추가하면
#   deploy-pages.yml 빌드 단계에서 자동으로 주입됩니다.
VITE_OPENWEATHER_API_KEY=your_api_key_here
